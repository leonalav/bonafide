{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bonafide",
  "version": "1.0.0",
  "identifier": "com.bonafide.app",
  "build": {
    "beforeDevCommand": "pnpm dev:renderer",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:8443",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bonafide",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0c0e13",
        "titleBarStyle": "Visible",
        "visible": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Bonafide — desktop app for ML experiment tracking and analysis",
    "longDescription": "Bonafide — desktop app for ML experiment tracking and analysis"
  },
  "plugins": {}
}
